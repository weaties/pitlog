# Copy to .env — `make dev` does this for you if .env is missing.

# --- Database -----------------------------------------------------------
# Host port for the Docker Compose Postgres. 5433 by default so it does not
# collide with a Postgres you may already run on 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgres://pitlog:pitlog@localhost:5433/pitlog

# --- API ----------------------------------------------------------------
API_PORT=8787
# 32+ random bytes. Signs session cookies and magic-link tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=dev-only-insecure-secret-change-me-0000000000

# Where the web app is served from; used to build magic-link URLs and to set CORS.
APP_ORIGIN=http://localhost:5173

# Mail transport for magic links.
#   console — print the link to stdout (default for local dev, no SMTP needed)
#   smtp    — not implemented in M0
MAIL_TRANSPORT=console

# --- Web ----------------------------------------------------------------
VITE_API_URL=http://localhost:8787
