{
  "extends": "./tsconfig.base.json",
  // `page.evaluate` bodies run in the browser, so the e2e project needs the
  // DOM lib even though Playwright itself runs under Node.
  "compilerOptions": {
    "outDir": ".tsc/tools",
    "types": ["node"],
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["playwright.config.ts", "vitest.config.ts", "tests/**/*.ts"]
}
